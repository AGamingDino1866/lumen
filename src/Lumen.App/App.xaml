<Application x:Class="Lumen.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- WPF-UI first, so Lumen's own tokens and styles win on any key collision. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />

                <!--
                    Layer 1: raw values. The only file permitted to hold a hex colour.
                    Must precede the semantic layer, which aliases these keys.
                -->
                <ResourceDictionary Source="Themes/Primitives.xaml" />

                <!--
                    Layer 2: semantic aliases. ThemeService REPLACES this entry in place when the
                    theme changes; it locates it by the marker key Lumen.Surface.Canvas rather
                    than by index, so the position here can change safely.
                -->
                <ResourceDictionary Source="Themes/Semantic.Light.xaml" />

                <!-- Layer 3: component tokens and styles. Reads semantic keys only. -->
                <ResourceDictionary Source="Themes/Components.xaml" />

                <!-- Motion tokens. MotionService zeroes these when Windows animations are off. -->
                <ResourceDictionary Source="Themes/Motion.xaml" />

                <!-- Geometry-based icons. No icon font, no stock glyphs, no emoji. -->
                <ResourceDictionary Source="Themes/Icons.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
