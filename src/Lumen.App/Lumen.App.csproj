<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Enabled only for System.Windows.Forms.Screen, which is the supported way to enumerate
         every connected monitor's working area. That is what lets a saved window position be
         validated against the displays currently attached, rather than restoring off-screen
         onto a monitor that has been unplugged. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Lumen.App</RootNamespace>
    <AssemblyName>Lumen</AssemblyName>
    <ApplicationIcon>..\..\installer\assets\lumen.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publish profile. PublishTrimmed is deliberately absent: WPF does not trim
       reliably and produces XamlParseExceptions that only surface after install.
       The cost is installer size, which is stated in the README. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- UseWindowsForms is on solely for System.Windows.Forms.Screen (multi-monitor enumeration
       for window-placement validation). Its SDK-injected global using otherwise collides with
       half of System.Windows on every ambiguous type (Application, MessageBox, Clipboard,
       DataFormats, ...), so it is removed here; the one call site aliases Screen explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumen.Core\Lumen.Core.csproj" />
  </ItemGroup>

  <!-- Geist Sans and Geist Mono are bundled (SIL Open Font License) so the interface
       renders identically on every machine with no network fetch and no system
       font dependency. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\**\*.ttf" />
    <None Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
