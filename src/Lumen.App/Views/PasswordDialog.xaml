<Window x:Class="Lumen.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Lumen.Surface.Canvas}"
        FontFamily="{DynamicResource Lumen.Primitive.Font.Sans}">

    <!-- Shown instead of crashing on an encrypted PDF. -->
    <Border Padding="24">
        <StackPanel>
            <TextBlock Style="{StaticResource Lumen.TextStyle.Title}" Text="This PDF is protected" />

            <TextBlock x:Name="FileNameText"
                       Style="{StaticResource Lumen.TextStyle.Secondary}"
                       Margin="0,6,0,16"
                       TextWrapping="Wrap" />

            <PasswordBox x:Name="PasswordBox"
                         Padding="10,8"
                         FontFamily="{DynamicResource Lumen.Primitive.Font.Mono}"
                         Background="{DynamicResource Lumen.Surface.Raised}"
                         Foreground="{DynamicResource Lumen.Text.Primary}"
                         BorderBrush="{DynamicResource Lumen.Border.Subtle}"
                         BorderThickness="1"
                         AutomationProperties.Name="PDF password" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource Lumen.Button.Secondary}"
                        Content="Cancel"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        Click="OnCancel" />
                <Button Style="{StaticResource Lumen.Button.Primary}"
                        Content="Open"
                        IsDefault="True"
                        Click="OnOpen" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
