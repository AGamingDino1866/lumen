<Window x:Class="Lumen.App.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumen"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Lumen.Surface.Canvas}"
        FontFamily="{DynamicResource Lumen.Primitive.Font.Sans}">

    <!--
        Recoverable, not fatal. The application keeps running because the open document and the
        extracted text live only in memory: closing the window would destroy work the user
        cannot get back without paying for extraction again.
    -->
    <Border Padding="24">
        <StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Path Style="{StaticResource Lumen.IconPath}"
                      Data="{StaticResource Lumen.Icon.Alert}"
                      Stroke="{DynamicResource Lumen.Danger.Default}"
                      Width="22" Height="22"
                      VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Lumen.Text.Title}"
                           Text="Something went wrong"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Style="{StaticResource Lumen.Text.Body}"
                       Text="Lumen hit an unexpected problem, but it is still running and your open document and extracted text are intact."
                       Margin="0,0,0,12" />

            <Border Background="{DynamicResource Lumen.Surface.Sunken}"
                    BorderBrush="{DynamicResource Lumen.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Lumen.Button.Radius}"
                    Padding="12"
                    Margin="0,0,0,12">
                <TextBlock x:Name="DetailText"
                           Style="{StaticResource Lumen.Text.Mono}"
                           TextWrapping="Wrap"
                           MaxHeight="120" />
            </Border>

            <TextBlock Style="{StaticResource Lumen.Text.Small}"
                       Margin="0,0,0,18">
                <Run Text="A full record was written to the log folder." />
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenLogsButton"
                        Style="{StaticResource Lumen.Button.Secondary}"
                        Content="Open log folder"
                        Margin="0,0,8,0"
                        Click="OnOpenLogs" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource Lumen.Button.Primary}"
                        Content="Continue"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OnClose" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
