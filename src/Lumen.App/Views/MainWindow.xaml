<ui:FluentWindow x:Class="Lumen.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:Lumen.App.Converters"
                 xmlns:vm="clr-namespace:Lumen.App.ViewModels"
                 Title="Lumen"
                 Width="1280" Height="820"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 Background="{DynamicResource Lumen.Surface.Canvas}"
                 FontFamily="{DynamicResource Lumen.Primitive.Font.Sans}"
                 DragEnter="OnDragEnter"
                 DragLeave="OnDragLeave"
                 Drop="OnDrop"
                 Closing="OnClosing">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:AspectRatioToHeightConverter x:Key="AspectToHeight" />
        <conv:StatusToBackgroundConverter x:Key="StatusBackground" />
        <conv:StatusToForegroundConverter x:Key="StatusForeground" />
        <conv:TextToFlowDirectionConverter x:Key="TextFlowDirection" />
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyAllMarkdownCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- title bar -->
            <RowDefinition Height="Auto" />   <!-- toolbar -->
            <RowDefinition Height="*" />      <!-- split content -->
            <RowDefinition Height="Auto" />   <!-- action bar -->
        </Grid.RowDefinitions>

        <!-- ===================== TITLE BAR =====================
             Custom chrome rather than default WPF window furniture. Carries the document
             identity, which is the "where am I" half of wayfinding. -->
        <ui:TitleBar Grid.Row="0" Height="40" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                    <Path Style="{StaticResource Lumen.IconPath}"
                          Data="{StaticResource Lumen.Icon.Extract}"
                          Stroke="{DynamicResource Lumen.Accent.Default}"
                          Width="15" Height="15"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Lumen"
                               Style="{StaticResource Lumen.TextStyle.Small}"
                               Foreground="{DynamicResource Lumen.Text.Primary}"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DocumentSummary}"
                               Style="{StaticResource Lumen.TextStyle.Small}"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ===================== TOOLBAR ===================== -->
        <Border Grid.Row="1"
                Padding="16,8"
                BorderBrush="{DynamicResource Lumen.Border.Subtle}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource Lumen.Button.Secondary}"
                        Command="{Binding OpenCommand}"
                        ToolTip="Open a different PDF (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Lumen.IconPath}" Data="{StaticResource Lumen.Icon.FolderOpen}" Width="15" Height="15" />
                        <TextBlock Text="Open" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Page-range entry. Errors render inline beneath, never as a message box. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Pages" Style="{StaticResource Lumen.TextStyle.Small}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBox x:Name="PageRangeBox"
                                 Style="{StaticResource Lumen.TextBox}"
                                 Width="200"
                                 Text="{Binding PageRangeText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Type a range such as 1-5, 12, 20-24 then press Enter"
                                 AutomationProperties.Name="Page range">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyPageRangeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding PageRangeError}"
                                   Style="{StaticResource Lumen.TextStyle.Small}"
                                   Foreground="{DynamicResource Lumen.Danger.Default}"
                                   MaxWidth="240"
                                   TextWrapping="Wrap"
                                   Margin="2,4,0,0"
                                   Visibility="{Binding PageRangeError, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Result actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="CopyAllButton"
                            Style="{StaticResource Lumen.Button.Secondary}"
                            Command="{Binding CopyAllMarkdownCommand}"
                            Click="OnCopyAllClick"
                            IsEnabled="{Binding HasResults}"
                            ToolTip="Copy every extracted page (Ctrl+Shift+C)"
                            AutomationProperties.Name="Copy all pages">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="CopyAllIcon"
                                  Style="{StaticResource Lumen.IconPath}"
                                  Data="{StaticResource Lumen.Icon.Copy}"
                                  Width="15" Height="15" />
                            <TextBlock x:Name="CopyAllLabel" Text="Copy All" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Format picker for Copy All: as formatted text, as markdown, or as plain
                         text with markdown syntax stripped. A separate small button rather than
                         a split button, since WPF-UI ships no SplitButton primitive. -->
                    <Button Style="{StaticResource Lumen.Button.Secondary}"
                            Click="OnCopyAllFormatClick"
                            IsEnabled="{Binding HasResults}"
                            ToolTip="Choose a copy format"
                            AutomationProperties.Name="Copy all, choose format"
                            Padding="6,7"
                            Margin="1,0,8,0">
                        <Path Style="{StaticResource Lumen.IconPath}" Data="{StaticResource Lumen.Icon.ChevronDown}" Width="11" Height="11" />
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="As formatted text" Command="{Binding CopyAllFormattedCommand}" />
                                <MenuItem Header="As markdown" Command="{Binding CopyAllMarkdownCommand}" />
                                <MenuItem Header="As plain text" Command="{Binding CopyAllPlainTextCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource Lumen.Button.Secondary}"
                            Click="OnExportClick"
                            IsEnabled="{Binding HasResults}"
                            ToolTip="Export to Word, Markdown, or plain text"
                            AutomationProperties.Name="Export"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Lumen.IconPath}" Data="{StaticResource Lumen.Icon.Export}" Width="15" Height="15" />
                            <TextBlock Text="Export" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Lumen.Button.Icon}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="Switch between light and dark"
                            AutomationProperties.Name="Toggle theme">
                        <Path x:Name="ThemeIcon"
                              Style="{StaticResource Lumen.IconPath}"
                              Data="{StaticResource Lumen.Icon.Moon}" />
                    </Button>

                    <Button Style="{StaticResource Lumen.Button.Icon}"
                            Click="OnOpenSettings"
                            ToolTip="Settings"
                            AutomationProperties.Name="Settings">
                        <Path Style="{StaticResource Lumen.IconPath}" Data="{StaticResource Lumen.Icon.Settings}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== CONTENT ===================== -->
        <Grid Grid.Row="2">

            <!-- ========== Start screen: the empty state that teaches the interface ========== -->
            <Grid Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">

                    <Border Width="88" Height="88"
                            CornerRadius="{StaticResource Lumen.PageTile.Radius}"
                            Background="{DynamicResource Lumen.Surface.Raised}"
                            BorderBrush="{DynamicResource Lumen.Border.Subtle}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Path Style="{StaticResource Lumen.IconPath}"
                              Data="{StaticResource Lumen.Icon.Page}"
                              Stroke="{DynamicResource Lumen.Text.Secondary}"
                              Width="34" Height="34" />
                    </Border>

                    <TextBlock Style="{StaticResource Lumen.TextStyle.Display}"
                               Text="Drop a PDF to begin"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0" />

                    <TextBlock Style="{StaticResource Lumen.TextStyle.Secondary}"
                               Text="Choose the pages you care about, and Lumen transcribes just those with Gemini."
                               TextAlignment="Center"
                               Margin="0,8,0,24" />

                    <Button Style="{StaticResource Lumen.Button.Primary}"
                            Command="{Binding OpenCommand}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Lumen.IconPath}"
                                  Data="{StaticResource Lumen.Icon.FolderOpen}"
                                  Stroke="{DynamicResource Lumen.Text.OnInk}"
                                  Width="15" Height="15" />
                            <TextBlock Text="Open a PDF" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Style="{StaticResource Lumen.TextStyle.Small}"
                               Text="or press Ctrl+O"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />

                    <!-- Recent files, with a way to clear them -->
                    <StackPanel Margin="0,36,0,0"
                                Visibility="{Binding RecentFiles.Count, Converter={StaticResource NotEmptyToVisibility}}">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="RECENT" Style="{StaticResource Lumen.TextStyle.Label}" />
                            <Button Style="{StaticResource Lumen.Button.Icon}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearRecentFilesCommand}"
                                    ToolTip="Clear the recent files list"
                                    AutomationProperties.Name="Clear recent files">
                                <Path Style="{StaticResource Lumen.IconPath}" Data="{StaticResource Lumen.Icon.Close}" Width="13" Height="13" />
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecentFileViewModel}">
                                    <Button Style="{StaticResource Lumen.Button.Icon}"
                                            HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,2"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Lumen.IconPath}" Data="{StaticResource Lumen.Icon.Page}" Width="14" Height="14" />
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Lumen.TextStyle.Body}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Directory}" Style="{StaticResource Lumen.TextStyle.Small}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Inline rejection message. Never a MessageBox. -->
                    <Border Margin="0,20,0,0"
                            Padding="12,8"
                            CornerRadius="{StaticResource Lumen.Button.Radius}"
                            Background="{DynamicResource Lumen.Status.Failed}"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource Lumen.TextStyle.Small}"
                                   Foreground="{DynamicResource Lumen.Status.Failed.Fg}"
                                   TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </Grid>

            <!-- ========== Split view: page grid | results ========== -->
            <Grid Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GridColumn" Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ResultsColumn" Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- PAGE GRID
                     Virtualizing with recycling: a 400-page document must never allocate 400
                     bitmaps. Extended selection gives Ctrl+Click and Shift+Click range. -->
                <ListView x:Name="PageGrid"
                          Grid.Column="0"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="12"
                          SelectionMode="Extended"
                          ItemsSource="{Binding Pages}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SelectionChanged="OnPageSelectionChanged"
                          MouseDoubleClick="OnPageDoubleClick"
                          AutomationProperties.Name="Page thumbnails">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="{StaticResource Lumen.PageTile.Margin}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource Lumen.FocusVisual}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!-- A plain click just toggles that page, accumulating, with no
                                 modifier key needed. Extended mode's own default is to replace
                                 the whole selection on a plain click and only accumulate on
                                 Ctrl+Click. Shift+Click still falls through to native Extended
                                 behaviour for a contiguous range. -->
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTilePreviewMouseDown" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageTileViewModel}">
                            <Border x:Name="Tile"
                                    Width="{StaticResource Lumen.PageTile.Width}"
                                    Background="{DynamicResource Lumen.Surface.Raised}"
                                    BorderBrush="{DynamicResource Lumen.Border.Subtle}"
                                    BorderThickness="{StaticResource Lumen.PageTile.BorderThickness}"
                                    CornerRadius="{StaticResource Lumen.PageTile.Radius}"
                                    SnapsToDevicePixels="True"
                                    Loaded="OnTileLoaded"
                                    AutomationProperties.Name="{Binding AutomationName}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Aspect-correct skeleton. Reserves the finished size so the
                                         grid never reflows and scroll position never jumps. -->
                                    <Border Grid.Row="0"
                                            Height="{Binding AspectRatio, Converter={StaticResource AspectToHeight}, ConverterParameter=154}"
                                            Background="{DynamicResource Lumen.Skeleton.Base}"
                                            CornerRadius="8,8,0,0" />

                                    <Image Grid.Row="0"
                                           Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding Thumbnail, Converter={StaticResource NotEmptyToVisibility}}" />

                                    <!-- Per-page render failure. The grid survives one bad page. -->
                                    <TextBlock Grid.Row="0"
                                               Text="Could not render"
                                               Style="{StaticResource Lumen.TextStyle.Small}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsRenderFailed, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Selection badge: Scale in from 0.92, 120ms, ease-out.
                                         Storyboard fires only when AnimateSelection is true,
                                         i.e. pointer-initiated. Ctrl+A animates nothing. -->
                                    <Border x:Name="Badge"
                                            Grid.Row="0"
                                            Width="24" Height="24"
                                            Margin="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            CornerRadius="12"
                                            Background="{DynamicResource Lumen.Accent.Default}"
                                            RenderTransformOrigin="0.5,0.5"
                                            Opacity="0"
                                            Visibility="Collapsed">
                                        <Border.RenderTransform>
                                            <!-- Static default is the settled scale (1): a plain
                                                 Setter on a DataTemplate trigger cannot target a
                                                 nested Freezable's property (MC4111), so the
                                                 keyboard/silent selection path needs no Setter
                                                 here at all — the badge simply appears already at
                                                 rest. The pointer path's Storyboard below sets its
                                                 own explicit From="0.92", independent of this
                                                 static value, so the scale-in still animates. -->
                                            <ScaleTransform x:Name="BadgeScale" ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <Path Data="{StaticResource Lumen.Icon.Check}"
                                              Stroke="{DynamicResource Lumen.Text.OnAccent}"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"
                                              Width="13" Height="13" />
                                    </Border>

                                    <Border Grid.Row="1" Padding="8,5">
                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                   Style="{StaticResource Lumen.TextStyle.Label}"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Lumen.State.Selected.Border}" />
                                    <Setter TargetName="Tile" Property="BorderThickness" Value="{StaticResource Lumen.PageTile.SelectedBorderThickness}" />
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Lumen.State.Selected.Fill}" />
                                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Badge" Property="Opacity" Value="1" />
                                </DataTrigger>

                                <!-- Animated variant, used only for pointer-initiated selection. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                        <Condition Binding="{Binding AnimateSelection}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Badge"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1"
                                                                 Duration="{StaticResource Lumen.Duration.BadgeIn}" />
                                                <DoubleAnimation Storyboard.TargetName="BadgeScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 From="0.92" To="1"
                                                                 Duration="{StaticResource Lumen.Duration.BadgeIn}">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BadgeScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 From="0.92" To="1"
                                                                 Duration="{StaticResource Lumen.Duration.BadgeIn}">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                </MultiDataTrigger>

                                <DataTrigger Binding="{Binding IsRenderFailed}" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Lumen.Status.Failed.Fg}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Splitter. Position persists across sessions. -->
                <GridSplitter x:Name="Splitter"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ShowsPreview="False"
                              AutomationProperties.Name="Resize panels" />

                <!-- RESULTS PANEL
                     Opaque, not translucent: a light translucent surface stacked on the Mica
                     backdrop would destroy text legibility. -->
                <Border Grid.Column="2"
                        Background="{DynamicResource Lumen.Surface.Raised}"
                        BorderBrush="{DynamicResource Lumen.Border.Subtle}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Find in results -->
                        <Border Grid.Row="0"
                                Padding="16,10"
                                BorderBrush="{DynamicResource Lumen.Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox x:Name="FindBox"
                                             Style="{StaticResource Lumen.TextBox}"
                                             Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnFindTextChanged"
                                             PreviewKeyDown="OnFindBoxPreviewKeyDown"
                                             ToolTip="Enter jumps to the next match, Shift+Enter to the previous"
                                             AutomationProperties.Name="Find in results" />
                                    <TextBlock Text="Find in results (Ctrl+F)"
                                               Style="{StaticResource Lumen.TextStyle.Small}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding FindText, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                                </Grid>

                                <ToggleButton Grid.Column="1"
                                              Margin="8,0,0,0"
                                              IsChecked="{Binding IsMergedView}"
                                              Content="Merged"
                                              ToolTip="Switch between one merged document and per-page cards"
                                              AutomationProperties.Name="Merged view" />
                            </Grid>
                        </Border>

                        <!-- Empty state: points at the primary action -->
                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="320"
                                    Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibility}}">
                            <Path Style="{StaticResource Lumen.IconPath}"
                                  Data="{StaticResource Lumen.Icon.Extract}"
                                  Stroke="{DynamicResource Lumen.Text.Disabled}"
                                  Width="30" Height="30"
                                  HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Lumen.TextStyle.Subtitle}"
                                       Text="Nothing extracted yet"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource Lumen.TextStyle.Secondary}"
                                       Text="Select the pages you want on the left, then press Extract Text."
                                       TextAlignment="Center"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- MERGED RESULTS
                             Continuous flow. No card chrome: a hairline rule plus a small-caps
                             "Page N" divider separates sections, and that divider is the anchor
                             for scroll sync and for per-page copy and retry. -->
                        <ScrollViewer x:Name="ResultsScroller"
                                      Grid.Row="1"
                                      Padding="{StaticResource Lumen.Panel.Padding}"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl x:Name="ResultsItems"
                                          ItemsSource="{Binding Results}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PageResultViewModel}">
                                        <StackPanel x:Name="Section" Margin="0,0,0,20">

                                            <!-- Page divider: the anchor. Hover or keyboard focus
                                                 reveals this page's actions. Clicking it scrolls
                                                 and selects the matching thumbnail in the grid. -->
                                            <Grid Margin="0,0,0,10"
                                                  Background="Transparent"
                                                  MouseLeftButtonUp="OnResultDividerClick"
                                                  Cursor="Hand">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding PageNumber, StringFormat='PAGE {0}'}"
                                                           Style="{StaticResource Lumen.TextStyle.Label}"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="1"
                                                        Style="{StaticResource Lumen.Divider}"
                                                        Margin="10,0,10,0"
                                                        VerticalAlignment="Center" />

                                                <!-- Status chip: colour AND word -->
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource Lumen.Chip}"
                                                        Background="{Binding Status, Converter={StaticResource StatusBackground}}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               Style="{StaticResource Lumen.Chip.Text}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusForeground}}" />
                                                </Border>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                                                    <Button Style="{StaticResource Lumen.Button.Icon}"
                                                            Command="{Binding DataContext.RetryPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Retry this page"
                                                            AutomationProperties.Name="Retry page"
                                                            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                                        <Path Style="{StaticResource Lumen.IconPath}" Data="{StaticResource Lumen.Icon.Retry}" Width="14" Height="14" />
                                                    </Button>

                                                    <Button Style="{StaticResource Lumen.Button.Icon}"
                                                            Command="{Binding DataContext.CopyPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Click="OnCopyPageClick"
                                                            ToolTip="Copy this page"
                                                            AutomationProperties.Name="Copy page"
                                                            Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}">
                                                        <Path Style="{StaticResource Lumen.IconPath}" Data="{StaticResource Lumen.Icon.Copy}" Width="14" Height="14" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Transcription -->
                                            <TextBox Text="{Binding Markdown, Mode=OneWay}"
                                                     FlowDirection="{Binding Markdown, Converter={StaticResource TextFlowDirection}}"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource Lumen.Text.Primary}"
                                                     FontFamily="{DynamicResource Lumen.Primitive.Font.Sans}"
                                                     FontSize="{DynamicResource Lumen.Primitive.Type.Size.Body}"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     IsTabStop="False"
                                                     Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}"
                                                     AutomationProperties.Name="{Binding AutomationName}" />

                                            <TextBlock Text="This page contained no readable text."
                                                       Style="{StaticResource Lumen.TextStyle.Small}"
                                                       FontStyle="Italic"
                                                       Visibility="{Binding IsBlank, Converter={StaticResource BoolToVisibility}}" />

                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       Style="{StaticResource Lumen.TextStyle.Small}"
                                                       Foreground="{DynamicResource Lumen.Status.Failed.Fg}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <DataTemplate.Triggers>
                                            <!-- Enter animation per page, fired when the page
                                                 actually finishes. Deliberately NOT a stagger:
                                                 adding synthetic delay to a real wait is wrong. -->
                                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Section"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1"
                                                                             Duration="{StaticResource Lumen.Duration.ResultEnter}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== ACTION BAR ===================== -->
        <Border Grid.Row="3"
                Padding="16,12"
                Background="{DynamicResource Lumen.Surface.Raised}"
                BorderBrush="{DynamicResource Lumen.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding SelectionSummary}"
                           Style="{StaticResource Lumen.TextStyle.Body}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="{Binding ProgressText}"
                               Style="{StaticResource Lumen.TextStyle.Small}"
                               Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibility}}" />
                    <ProgressBar Height="3"
                                 Margin="0,4,0,0"
                                 Value="{Binding ProgressValue}"
                                 Maximum="100"
                                 Background="{DynamicResource Lumen.Surface.Sunken}"
                                 Foreground="{DynamicResource Lumen.Accent.Default}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource Lumen.TextStyle.Small}"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource Lumen.Button.Secondary}"
                            Command="{Binding CancelExtractionCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Lumen.IconPath}" Data="{StaticResource Lumen.Icon.Stop}" Width="13" Height="13" />
                            <TextBlock Text="Cancel" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Primary action. Disabled with a tooltip that says WHY. -->
                    <Button Style="{StaticResource Lumen.Button.Primary}"
                            Command="{Binding ExtractCommand}"
                            IsEnabled="{Binding CanExtract}"
                            ToolTip="{Binding ExtractDisabledReason}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Extract text from the selected pages">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Lumen.IconPath}"
                                  Data="{StaticResource Lumen.Icon.Extract}"
                                  Stroke="{DynamicResource Lumen.Text.OnInk}"
                                  Width="15" Height="15" />
                            <TextBlock Text="Extract Text" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== DROP OVERLAY =====================
             Full-window. Fades in on DragEnter; exit is faster than enter. -->
        <Border x:Name="DropOverlay"
                Grid.RowSpan="4"
                Background="{DynamicResource Lumen.Surface.Scrim}"
                Visibility="Collapsed"
                Opacity="0"
                IsHitTestVisible="False">
            <Border x:Name="DropCard"
                    Width="360"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Lumen.Surface.Overlay}"
                    BorderBrush="{DynamicResource Lumen.Accent.Default}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource Lumen.PageTile.Radius}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DropCardScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <StackPanel>
                    <Path Style="{StaticResource Lumen.IconPath}"
                          Data="{StaticResource Lumen.Icon.Page}"
                          Stroke="{DynamicResource Lumen.Accent.Default}"
                          Width="34" Height="34"
                          HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Lumen.TextStyle.Subtitle}"
                               Text="Drop your PDF here"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</ui:FluentWindow>
