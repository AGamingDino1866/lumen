<Window x:Class="Lumen.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumen settings"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Lumen.Surface.Canvas}"
        FontFamily="{DynamicResource Lumen.Primitive.Font.Sans}">

    <!--
        Progressive disclosure: the common path (open, select, extract, copy) is on the main
        window. Model choice, theme, key management, and export defaults live one level deeper,
        here, because they are set once and then forgotten.
    -->
    <Border Padding="28">
        <StackPanel>

            <TextBlock Style="{StaticResource Lumen.TextStyle.Title}" Text="Settings" Margin="0,0,0,20" />

            <!-- ============ API key ============ -->
            <TextBlock Text="API KEY" Style="{StaticResource Lumen.TextStyle.Label}" Margin="0,0,0,8" />

            <Border Background="{DynamicResource Lumen.Surface.Raised}"
                    BorderBrush="{DynamicResource Lumen.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Lumen.Button.Radius}"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Masked, never shown in full. -->
                        <TextBlock x:Name="MaskedKeyText" Style="{StaticResource Lumen.TextStyle.Mono}" />
                        <TextBlock Style="{StaticResource Lumen.TextStyle.Small}"
                                   Text="Encrypted with Windows DPAPI. Readable only by you, on this machine."
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Lumen.Button.Secondary}"
                                Content="Replace"
                                Margin="0,0,6,0"
                                Click="OnReplaceKey" />
                        <Button Style="{StaticResource Lumen.Button.Secondary}"
                                Content="Delete"
                                Click="OnDeleteKey" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Model ============ -->
            <TextBlock Text="MODEL" Style="{StaticResource Lumen.TextStyle.Label}" Margin="0,24,0,8" />

            <ComboBox x:Name="ModelCombo"
                      Padding="10,7"
                      SelectionChanged="OnModelChanged"
                      AutomationProperties.Name="Gemini model">
                <ComboBoxItem Content="gemini-2.5-flash" Tag="gemini-2.5-flash" />
                <ComboBoxItem Content="gemini-2.5-pro" Tag="gemini-2.5-pro" />
            </ComboBox>

            <TextBlock Style="{StaticResource Lumen.TextStyle.Small}"
                       Text="Flash is the right cost and quality point for transcription. Pro is slower and more expensive, and is worth trying on unusually dense or difficult scans."
                       TextWrapping="Wrap"
                       Margin="2,6,0,0" />

            <!-- ============ Appearance ============ -->
            <TextBlock Text="APPEARANCE" Style="{StaticResource Lumen.TextStyle.Label}" Margin="0,24,0,8" />

            <ComboBox x:Name="ThemeCombo"
                      Padding="10,7"
                      SelectionChanged="OnThemeChanged"
                      AutomationProperties.Name="Theme">
                <ComboBoxItem Content="Follow Windows" Tag="System" />
                <ComboBoxItem Content="Light" Tag="Light" />
                <ComboBoxItem Content="Dark" Tag="Dark" />
            </ComboBox>

            <!-- ============ Export defaults ============ -->
            <TextBlock Text="EXPORT DEFAULTS" Style="{StaticResource Lumen.TextStyle.Label}" Margin="0,24,0,8" />

            <CheckBox x:Name="PageBreaksCheck"
                      Content="Start each source page on a new page in Word"
                      Foreground="{DynamicResource Lumen.Text.Primary}"
                      Margin="0,0,0,8"
                      Click="OnExportOptionChanged" />

            <CheckBox x:Name="PageHeadingsCheck"
                      Content="Add a &quot;Page N&quot; heading before each page"
                      Foreground="{DynamicResource Lumen.Text.Primary}"
                      Click="OnExportOptionChanged" />

            <!-- ============ Privacy ============ -->
            <Border Background="{DynamicResource Lumen.Surface.Sunken}"
                    CornerRadius="{StaticResource Lumen.Button.Radius}"
                    Padding="14"
                    Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="PRIVACY" Style="{StaticResource Lumen.TextStyle.Label}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Lumen.TextStyle.Small}"
                               TextWrapping="Wrap"
                               Text="Lumen has no account, no backend, and no telemetry. The only network request it makes is to Google's Generative Language API, carrying the page images you selected. Your PDF and the extracted text are never written to disk." />
                </StackPanel>
            </Border>

            <Button Style="{StaticResource Lumen.Button.Primary}"
                    Content="Done"
                    IsDefault="True"
                    IsCancel="True"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0"
                    Click="OnClose" />

        </StackPanel>
    </Border>
</Window>
