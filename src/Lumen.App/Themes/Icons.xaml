<!--
    ICONOGRAPHY

    Geometry resources on a 24x24 grid, drawn in the Phosphor idiom: slightly thicker strokes
    than a hairline set, consistent terminals, geometric construction.

    Deliberately NOT an icon font and NOT the stock WPF/Segoe glyphs. A font dependency would
    either need bundling or would render differently across Windows versions, and stock glyphs
    are the fastest way to make an application look generic. These are paths, so they inherit
    the current foreground brush and stay crisp at any DPI.

    No emoji is used anywhere in the interface.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Folder, open: the Open action -->
    <PathGeometry x:Key="Lumen.Icon.FolderOpen"
        Figures="M3 7.5 A1.5 1.5 0 0 1 4.5 6 H9.2 L11.2 8.4 H18.5 A1.5 1.5 0 0 1 20 9.9 V10.5 H6.6 A1.5 1.5 0 0 0 5.16 11.6 L3 19 Z
                 M6.6 12 H21.2 A0.6 0.6 0 0 1 21.78 12.76 L19.9 19.3 A1.5 1.5 0 0 1 18.46 20.4 H3 Z" />

    <!-- Document page: page tiles, empty states -->
    <PathGeometry x:Key="Lumen.Icon.Page"
        Figures="M6 3 H14.5 L19 7.5 V21 H6 Z M14.2 3.4 V7.8 H18.6"
        FillRule="Nonzero" />

    <!-- Copy: two offset sheets -->
    <PathGeometry x:Key="Lumen.Icon.Copy"
        Figures="M9 9 H20 V20 H9 Z M5.5 15.5 H4 V4 H15.5 V5.6" />

    <!-- Check: the copied confirmation and the selection badge -->
    <PathGeometry x:Key="Lumen.Icon.Check"
        Figures="M4.8 12.6 L9.6 17.4 L19.2 6.8" />

    <!-- Export / download -->
    <PathGeometry x:Key="Lumen.Icon.Export"
        Figures="M12 3.5 V14.8 M7.4 10.4 L12 15 L16.6 10.4 M4.5 17.5 V20 H19.5 V17.5" />

    <!-- Gear: settings -->
    <PathGeometry x:Key="Lumen.Icon.Settings"
        Figures="M12 8.6 A3.4 3.4 0 1 0 12 15.4 A3.4 3.4 0 1 0 12 8.6 Z
                 M10.6 2.6 H13.4 L13.9 5.2 L15.9 6 L18.1 4.6 L20.1 6.6 L18.7 8.8 L19.5 10.8 L22 11.3 V14.1 L19.5 14.6 L18.7 16.6 L20.1 18.8 L18.1 20.8 L15.9 19.4 L13.9 20.2 L13.4 22.8 H10.6 L10.1 20.2 L8.1 19.4 L5.9 20.8 L3.9 18.8 L5.3 16.6 L4.5 14.6 L2 14.1 V11.3 L4.5 10.8 L5.3 8.8 L3.9 6.6 L5.9 4.6 L8.1 6 L10.1 5.2 Z" />

    <!-- Magnifier: find in results -->
    <PathGeometry x:Key="Lumen.Icon.Search"
        Figures="M10.8 4 A6.8 6.8 0 1 0 10.8 17.6 A6.8 6.8 0 1 0 10.8 4 Z M15.9 15.9 L20.5 20.5" />

    <!-- Arrow, clockwise: per-page retry -->
    <PathGeometry x:Key="Lumen.Icon.Retry"
        Figures="M20 12 A8 8 0 1 1 17.66 6.34 M20 3.2 V7.2 H16" />

    <!-- Close / clear -->
    <PathGeometry x:Key="Lumen.Icon.Close"
        Figures="M5.6 5.6 L18.4 18.4 M18.4 5.6 L5.6 18.4" />

    <!-- Chevrons: page preview navigation -->
    <PathGeometry x:Key="Lumen.Icon.ChevronLeft" Figures="M15 5 L8 12 L15 19" />
    <PathGeometry x:Key="Lumen.Icon.ChevronRight" Figures="M9 5 L16 12 L9 19" />
    <PathGeometry x:Key="Lumen.Icon.ChevronDown" Figures="M5 9 L12 16 L19 9" />

    <!-- Warning triangle: error states -->
    <PathGeometry x:Key="Lumen.Icon.Alert"
        Figures="M12 3.6 L22 20.4 H2 Z M12 9.6 V14.4 M12 16.8 V17.6" />

    <!-- Eye and eye-slash: the API key show/hide toggle -->
    <PathGeometry x:Key="Lumen.Icon.Eye"
        Figures="M2 12 C5 6.8 8.4 4.8 12 4.8 C15.6 4.8 19 6.8 22 12 C19 17.2 15.6 19.2 12 19.2 C8.4 19.2 5 17.2 2 12 Z
                 M12 8.8 A3.2 3.2 0 1 0 12 15.2 A3.2 3.2 0 1 0 12 8.8 Z" />
    <PathGeometry x:Key="Lumen.Icon.EyeSlash"
        Figures="M2 12 C5 6.8 8.4 4.8 12 4.8 C15.6 4.8 19 6.8 22 12 C19 17.2 15.6 19.2 12 19.2 C8.4 19.2 5 17.2 2 12 Z
                 M12 8.8 A3.2 3.2 0 1 0 12 15.2 A3.2 3.2 0 1 0 12 8.8 Z
                 M3.5 3.5 L20.5 20.5" />

    <!-- Sun and moon: the theme override -->
    <PathGeometry x:Key="Lumen.Icon.Sun"
        Figures="M12 7.6 A4.4 4.4 0 1 0 12 16.4 A4.4 4.4 0 1 0 12 7.6 Z
                 M12 2 V4.4 M12 19.6 V22 M2 12 H4.4 M19.6 12 H22
                 M4.9 4.9 L6.6 6.6 M17.4 17.4 L19.1 19.1 M19.1 4.9 L17.4 6.6 M6.6 17.4 L4.9 19.1" />
    <PathGeometry x:Key="Lumen.Icon.Moon"
        Figures="M20.4 14.6 A9 9 0 1 1 9.4 3.6 A7.2 7.2 0 0 0 20.4 14.6 Z" />

    <!-- Plus and minus: preview zoom -->
    <PathGeometry x:Key="Lumen.Icon.Plus" Figures="M12 5 V19 M5 12 H19" />
    <PathGeometry x:Key="Lumen.Icon.Minus" Figures="M5 12 H19" />

    <!-- Stop: cancel an extraction run -->
    <PathGeometry x:Key="Lumen.Icon.Stop" Figures="M6.5 6.5 H17.5 V17.5 H6.5 Z" />

    <!-- Sparkle: the Extract action. Distinct from a generic play or arrow. -->
    <PathGeometry x:Key="Lumen.Icon.Extract"
        Figures="M12 3 L13.9 9.1 L20 11 L13.9 12.9 L12 19 L10.1 12.9 L4 11 L10.1 9.1 Z
                 M18.5 16 L19.3 18.2 L21.5 19 L19.3 19.8 L18.5 22 L17.7 19.8 L15.5 19 L17.7 18.2 Z" />

</ResourceDictionary>
