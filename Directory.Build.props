<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Product identity. AssemblyVersion is kept at the major.0.0.0 form so that
       servicing releases do not break binding; FileVersion and InformationalVersion
       carry the real build number, and build.ps1 reads Version to name the installer. -->
  <PropertyGroup>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Company>Lumen</Company>
    <Product>Lumen</Product>
    <Authors>Lumen</Authors>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

</Project>
